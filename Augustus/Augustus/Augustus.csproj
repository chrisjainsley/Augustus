<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InternalsVisibleTo>Augustus.Tests</InternalsVisibleTo>
    <InternalsVisibleTo>Augustus.AI</InternalsVisibleTo>
    <PackageId>Augustus</PackageId>
    <Version>0.0.0-local</Version>
    <Authors>Augustus Contributors</Authors>
    <Description>A lightweight API simulator library for .NET that serves configured route responses (static JSON, file-based, or custom strategies) with optional AI-powered fallback via the Augustus.AI package.</Description>
    <PackageTags>testing;mocking;api;simulator;xunit;nunit;mstest</PackageTags>
    <RepositoryUrl>https://github.com/chrisjainsley/augustus</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
