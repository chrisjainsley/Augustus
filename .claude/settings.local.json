{
  "permissions": {
    "allow": [
      "Bash(dotnet build)",
      "Bash(dotnet add:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet :*)",
      "Bash(dotnet test)",
      "Bash(dotnet test:*)",
      "Bash(del NUnitTests.cs)",
      "Bash(del MSTestTests.cs)",
      "Bash(rm:*)",
      "WebSearch"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Review all modified C# files for code quality issues, potential bugs, and security vulnerabilities. Fix any Critical or High priority issues found, then run the tests to verify.",
            "timeout": 300,
            "statusMessage": "Running automated code review..."
          }
        ]
      }
    ]
  }
}
